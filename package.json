{
  "name": "history-video-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "import:sample": "python3 scripts/import_sample.py",
